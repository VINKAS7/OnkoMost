# Copy this file to backend/.env and fill in the values.

# Language models. Any OpenAI-compatible API works. The defaults use e-INFRA CZ (https://llm.ai.e-infra.cz/status/).
# For a local Ollama instead: LLM_BASE_URL=http://localhost:11434/v1, no key, Ollama model names, RERANK_MODEL empty.
LLM_BASE_URL=https://llm.ai.e-infra.cz/v1
LLM_API_KEY=
# Model for reading reports and answering questions. "none" tells reasoning models to answer directly (faster,
# and the JSON output is not cut short). Leave it empty for models that do not support reasoning_effort.
LLM_MODEL=deepseek-v4.1-flash
LLM_REASONING_EFFORT=none
# Search over the patient's documents: embeddings for the first stage, a reranker for the second.
# Leave EMBED_MODEL empty for keyword search only, RERANK_MODEL empty to skip reranking.
# EMBED_DIM must match the embedding model. Changing either rebuilds the search index on the next start.
EMBED_MODEL=qwen3-embedding-4b
EMBED_DIM=2560
RERANK_MODEL=qwen3-reranker-4b

# InterSystems IRIS for Health, started with infra/iris/start.sh. The script sets the password of IRIS_USER to
# IRIS_PASSWORD. Use localhost with Docker Desktop or Linux; if Docker runs inside WSL, use the WSL IP (hostname -I).
IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_WEB_PORT=52773
IRIS_NAMESPACE=ONKOMOST
IRIS_USER=_SYSTEM
IRIS_PASSWORD=change-me
FHIR_PATH=/fhir/r4

# Workflow database (cases, tasks, votes). SQLite by default; any SQLAlchemy URL works.
SQLITE_URL=sqlite:///backend/data/onkomost.sqlite3

# Folder with the Rakathon sample patient (Pacient/ with 13 .docx reports, and MDT zaver.docx).
# Only needed for scripts/seed_demo.py and most of the tests.
SAMPLE_DATA_DIR=./sample-data
