# Copy to backend/.env and fill in.
OLLAMA_URL=http://localhost:11434
# Local LLM in Ollama (ollama pull qwen3.5:4b)
LLM_MODEL=qwen3.5:4b
SQLITE_URL=sqlite:///backend/data/onkomost.sqlite3
# Read-only folder with the Rakathon sample patient (13 .docx in Pacient/ + MDT zaver.docx)
SAMPLE_DATA_DIR=C:/Users/VINAYAK/Downloads/cesta-pacienta-data/rakathon_final_all

# InterSystems IRIS for Health (infra/iris): patient graph in globals, GraphRAG chunks in a SQL vector table,
# and the FHIR R4 server that holds the patient-identifying data. IRIS_HOST is the WSL IP when Docker runs in WSL.
IRIS_HOST=172.31.121.111
IRIS_PORT=1972
IRIS_WEB_PORT=52773
IRIS_NAMESPACE=ONKOMOST
IRIS_USER=_SYSTEM
IRIS_PASSWORD=
FHIR_PATH=/fhir/r4
# Ollama embedding model for the GraphRAG vector leg (ollama pull qwen3-embedding:0.6b, 639 MB).
# Leave EMBED_MODEL empty for keyword search only. EMBED_DIM must match the model's output size; changing either
# rebuilds Onk.DocChunk and re-embeds the stored text on the next start.
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
